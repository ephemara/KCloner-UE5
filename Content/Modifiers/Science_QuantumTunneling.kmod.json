{
  "AssetName": "Science_QuantumTunneling",
  "DisplayName": "Quantum Tunneling Wavepacket",
  "Category": "Science/Quantum",
  "Description": "A stylized wavepacket crossing an invisible potential barrier: reflected and evanescent components phase-cancel, tunnel, and reappear as clone geometry.",
  "KScript": "var width := max(v0,1.0); var phase := v1*x-t*v2+u*v3; var gaussian := exp(-(x*x+y*y)/(2.0*width*width)); var evanescent := exp(-abs(x)*v4/width); var carrier := cos(phase); var reflected := cos(-phase+v5*y+t*v6); var psi := gaussian*(carrier*v7+evanescent*reflected*v8); z += psi; sx := sx*(1.0+psi*v9); sy := sy*(1.0+psi*v9); sz := sz*(1.0+psi*v9); ry += psi*v10*0.02;",
  "Step": 0.08,
  "SpeedMultiplier": 1.0,
  "Variables": [
    { "Name": "PacketWidth", "DefaultValue": 180.0, "MinValue": 1.0, "MaxValue": 1000.0, "Tooltip": "Gaussian packet width" },
    { "Name": "WaveNumber", "DefaultValue": 0.09, "MinValue": 0.0, "MaxValue": 1.0, "Tooltip": "Carrier wave number" },
    { "Name": "PacketSpeed", "DefaultValue": 2.4, "MinValue": 0.0, "MaxValue": 20.0, "Tooltip": "Packet phase speed" },
    { "Name": "PhaseSpread", "DefaultValue": 2.0, "MinValue": 0.0, "MaxValue": 20.0, "Tooltip": "Per-instance phase difference" },
    { "Name": "BarrierDecay", "DefaultValue": 4.0, "MinValue": 0.0, "MaxValue": 20.0, "Tooltip": "Evanescent decay strength" },
    { "Name": "ReflectionPhase", "DefaultValue": 1.57, "MinValue": -6.28, "MaxValue": 6.28, "Tooltip": "Reflected-wave phase" },
    { "Name": "BarrierRippleSpeed", "DefaultValue": 0.8, "MinValue": 0.0, "MaxValue": 10.0, "Tooltip": "Barrier modulation speed" },
    { "Name": "IncidentAmplitude", "DefaultValue": 26.0, "MinValue": 0.0, "MaxValue": 200.0, "Tooltip": "Incident wave displacement" },
    { "Name": "TunnelAmplitude", "DefaultValue": 38.0, "MinValue": 0.0, "MaxValue": 200.0, "Tooltip": "Tunneled wave displacement" },
    { "Name": "ScaleResponse", "DefaultValue": 0.16, "MinValue": 0.0, "MaxValue": 2.0, "Tooltip": "Wave amplitude scale response" },
    { "Name": "RotationResponse", "DefaultValue": 8.0, "MinValue": 0.0, "MaxValue": 45.0, "Tooltip": "Wave rotation response" }
