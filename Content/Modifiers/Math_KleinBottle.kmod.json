  "KScript": "var ku := t*v0+u*v1+x*v2*0.01; var kv := t*v3+u*v4+y*v5*0.01; var ring := v6+cos(ku*0.5)*sin(kv)-sin(ku*0.5)*sin(2.0*kv); var kx := ring*cos(ku); var ky := ring*sin(ku); var kz := sin(ku*0.5)*sin(kv)+cos(ku*0.5)*sin(2.0*kv); x += kx*v7; y += ky*v7; z += kz*v7; rz += sin(ku)*v8;",
  "Step": 0.1,
  "SpeedMultiplier": 1.0,
